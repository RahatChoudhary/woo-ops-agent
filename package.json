{
  "name": "woo-ops-mcp",
  "version": "1.0.0",
  "description": "MCP server to manage a WooCommerce store from Claude, Cursor and other AI apps in plain language, with human approval before every change.",
  "type": "module",
  "bin": {
    "woo-ops-mcp": "dist/index.js"
  },
  "files": [
    "dist",
    "README.md",
    "CHANGELOG.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "tsc && node -e \"require('fs').chmodSync('dist/index.js', 0o755)\"",
    "dev": "tsx --env-file=.env src/index.ts",
    "test": "vitest run --passWithNoTests",
    "inspect": "npx @modelcontextprotocol/inspector node --env-file=.env dist/index.js",
    "test:wc": "tsx --env-file=.env scripts/test-wc.ts",
    "prepublishOnly": "npm run build && npm test"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/RahatChoudhary/woo-ops-agent.git"
  },
  "keywords": [
    "mcp",
    "woocommerce",
    "model-context-protocol",
    "claude",
    "ai-agent"
  ],
  "author": "Rahat Ali <rahatchaodhary@gmail.com>",
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/RahatChoudhary/woo-ops-agent/issues"
  },
  "homepage": "https://github.com/RahatChoudhary/woo-ops-agent#readme",
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.32.2",
    "@woocommerce/woocommerce-rest-api": "^1.0.2",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@types/node": "^26.6.5",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vitest": "^5.1.0"
  }
}
